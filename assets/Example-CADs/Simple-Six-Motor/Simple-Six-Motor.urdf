<?xml version="1.0" ?>
<robot name="Simple-Six-Motor.urdf">
  <link name="baseLink">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.0"/>
       <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Simple-Six-Motor.obj" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="red">
       <color rgba="255, 99, 71, 1"/>
     </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="Simple-Six-Motor.obj" scale="1.0 1.0 1.0"/>
        <!-- You could also specify the collision (for the Simple-Six-Motor) with a "box" tag: -->
        <!-- <box size=".06 .06 .06"/> -->
      </geometry>
    </collision>
  </link>
</robot>
        